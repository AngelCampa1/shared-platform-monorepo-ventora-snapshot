{
  "name": "@ventora/third-grade-copy-skill",
  "version": "0.2.0",
  "description": "Packaged Codex/Agents/Claude skill for third-grade marketing copy review",
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./skill": "./skill/third-grade-copy/SKILL.md"
  },
  "bin": {
    "third-grade-copy-skill": "./bin/install.mjs"
  },
  "files": ["bin", "index.js", "README.md", "skill", "!skill/**/__pycache__", "!skill/**/*.pyc"],
